# ConfigMap-backend: condivisa da Deployment-auth e Deployment-backend.
# Se modifichi questo file e fai push, Kustomize genera una ConfigMap con un nuovo
# hash nel nome e i Deployment fanno rollout da soli.
REDIS_HOST=db-headless
REDIS_PORT=6379
REDIS_DB=0
AUTH_URL=http://auth:8080
SESSION_TTL_SECONDS=86400
GOALS_TO_WIN=5
ROUND_TIMEOUT_SECONDS=15
RESULT_PAUSE_SECONDS=3.5
LOG_LEVEL=info
